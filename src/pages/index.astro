---
import { createClient } from 'redis';

export const prerender = false;

// Define all Gamemodes matching the MCTiers reference style
const gamemodes = ["Vanilla", "UHC", "Pot", "NethOP", "SMP", "Sword", "Axe", "Mace"];

// MCTiers-style SVG icons per gamemode matching your reference images
const gamemodeSvg = {
  "Vanilla": `<svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l8.66 5v10L12 22l-8.66-5V7L12 2z" opacity="0.15"/><path d="M12 2l8.66 5v10L12 22l-8.66-5V7L12 2zm0 2.2L5.5 7.8v8.4L12 19.8l6.5-3.6V7.8L12 4.2z"/></svg>`,
  "UHC": `<svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 21s-7.5-4.6-10-9.3C.3 8.1 2 4 6.2 4c2.1 0 3.8 1.4 5.8 4 2-2.6 3.7-4 5.8-4C22 4 23.7 8.1 22 11.7 19.5 16.4 12 21 12 21z"/></svg>`,
  "Pot": `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M9 3h6M10 3v5l-5 9a3 3 0 003 5h8a3 3 0 003-5l-5-9V3"/><circle cx="12" cy="15" r="1.5" fill="currentColor" stroke="none"/></svg>`,
  "NethOP": `<svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 3C8 3 5 6 5 10c0 3 1.5 5 2.5 6.5C8.5 18 9 19 9 21h6c0-2 .5-3 1.5-4.5C17.5 15 19 13 19 10c0-4-3-7-7-7z"/></svg>`,
  "SMP": `<svg viewBox="0 0 24 24" fill="currentColor"><circle cx="12" cy="12" r="9" opacity="0.2"/><circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="1.8"/></svg>`,
  "Sword": `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M14.5 3.5L21 10l-9.5 9.5L5 13 14.5 3.5z" fill="currentColor" opacity="0.15"/><path d="M14.5 3.5L21 10l-9.5 9.5L5 13 14.5 3.5z"/><path d="M5 13l-2.5 2.5 3.5 3.5L9 16.5M16 5l4 4"/></svg>`,
  "Axe": `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M5 3c5 0 8.5 3.5 8.5 8 0 1.8-.7 3-1.7 4l7.2 7-2 2-7.2-7c-1 1-2.2 1.7-4 1.7-4.5 0-8-3.5-8-8.5"/><path d="M13 11L20 4"/></svg>`,
  "Mace": `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="8" y="2" width="8" height="7" rx="1.5"/><path d="M12 9v13"/><path d="M8 22h8"/></svg>`,
};

const trophySvg = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M8 21h8M12 17v4M7 4h10v5a5 5 0 01-10 0V4z"/><path d="M7 5H4a3 3 0 003 5M17 5h3a3 3 0 01-3 5"/></svg>`;

// Titles list with icons and point thresholds
const titlesList = [
  { name: "Combat Grandmaster", icon: "👑", threshold: 450, color: "text-amber-300" },
  { name: "Combat Master", icon: "⭐", threshold: 250, color: "text-purple-300" },
  { name: "Combat Ace", icon: "✦", threshold: 100, color: "text-indigo-300" },
  { name: "Combat Specialist", icon: "◆", threshold: 50, color: "text-blue-300" },
  { name: "Combat Cadet", icon: "▲", threshold: 20, color: "text-cyan-300" },
  { name: "Combat Novice", icon: "●", threshold: 10, color: "text-emerald-300" },
  { name: "Rookie", icon: "○", threshold: 0, color: "text-slate-400" },
];

// Points per rank for the info modal
const rankPoints = [
  { tier: "HT1", pts: 60 }, { tier: "LT1", pts: 45 },
  { tier: "HT2", pts: 30 }, { tier: "LT2", pts: 20 },
  { tier: "HT3", pts: 10 }, { tier: "LT3", pts: 6 },
  { tier: "HT4", pts: 4 },  { tier: "LT4", pts: 3 },
  { tier: "HT5", pts: 2 },  { tier: "LT5", pts: 1 },
];

// Tier header styling (gold / silver / bronze / default)
const tierHeaderStyle = {
  1: { wrap: "bg-amber-900/30 border-amber-500/50", text: "text-amber-300" },
  2: { wrap: "bg-slate-500/20 border-slate-400/50", text: "text-slate-300" },
  3: { wrap: "bg-orange-900/30 border-orange-600/50", text: "text-orange-300" },
  4: { wrap: "bg-slate-900/40 border-purple-500/30", text: "text-purple-300" },
  5: { wrap: "bg-slate-900/40 border-purple-500/30", text: "text-purple-300" },
};

// Rank ribbon styling for top 3 global players
const rankRibbonStyle = {
  1: "bg-gradient-to-br from-amber-400 to-amber-600 text-amber-950",
  2: "bg-gradient-to-br from-slate-300 to-slate-500 text-slate-900",
  3: "bg-gradient-to-br from-orange-500 to-orange-700 text-orange-950",
};

// Helper function to calculate title based on total points
function getTitle(points) {
  if (points >= 450) return { name: "Combat Grandmaster", color: "text-amber-300 font-bold" };
  if (points >= 250) return { name: "Combat Master", color: "text-purple-300 font-bold" };
  if (points >= 100) return { name: "Combat Ace", color: "text-indigo-300 font-semibold" };
  if (points >= 50) return { name: "Combat Specialist", color: "text-blue-300 font-semibold" };
  if (points >= 20) return { name: "Combat Cadet", color: "text-cyan-300 font-medium" };
  if (points >= 10) return { name: "Combat Novice", color: "text-emerald-300 font-medium" };
  return { name: "Rookie", color: "text-slate-400" };
}

// Extract the numeric tier level (1-5) from a tier string like "HT1" or "LT3"
function tierNumber(tierStr) {
  const match = tierStr.match(/(\d)/);
  return match ? match[1] : '5';
}

// Load players from Redis
let playersData = [];

try {
  const client = createClient({ url: import.meta.env.REDIS_URL });
  await client.connect();
  const allPlayers = await client.hGetAll('players');
  await client.disconnect();

  playersData = Object.values(allPlayers).map((raw) => JSON.parse(raw));
} catch (err) {
  console.error('Failed to load players from Redis:', err);
}

// Normalize tier keys: strip spaces, uppercase (handles old inconsistent entries)
playersData = playersData.map((p) => {
  const normalizedTiers = {};
  for (const [key, value] of Object.entries(p.tiers || {})) {
    const normalizedKey = key.trim().toUpperCase().replace(/\s+/g, '');
    normalizedTiers[normalizedKey] = value;
  }
  return { ...p, tiers: normalizedTiers };
});

// Map over players to compute total points & rank dynamically
const players = playersData
  .map((p) => {
    const totalPts = Object.values(p.tiers).reduce((acc, curr) => acc + (curr.pts || 0), 0);
    const titleInfo = getTitle(totalPts);
    return {
      ...p,
      totalPoints: totalPts,
      title: titleInfo.name,
      titleColor: titleInfo.color,
    };
  })
  .sort((a, b) => b.totalPoints - a.totalPoints)
  .map((p, index) => ({ ...p, rank: index + 1 }));

// Build tier-column groups (1-5) per gamemode, mctiers-style
const tierListsByMode = {};
gamemodes.forEach((mode) => {
  const key = mode.replace(/\s+/g, '');
  const groups = { 1: [], 2: [], 3: [], 4: [], 5: [] };
  players.forEach((p) => {
    const gData = p.tiers[key];
    if (gData) {
      const num = tierNumber(gData.tier);
      groups[num].push({ name: p.name, avatar: p.avatar, tier: gData.tier });
    }
  });
  Object.keys(groups).forEach((k) => {
    groups[k].sort((a, b) => a.tier.localeCompare(b.tier));
  });
  tierListsByMode[key] = groups;
});
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<title>MOON TIERS - Global Rankings</title>
		<style is:global>
			@import "tailwindcss";
			.icon-sm svg { width: 18px; height: 18px; }
			.icon-xs svg { width: 14px; height: 14px; }
			.icon-md svg { width: 16px; height: 16px; }
			.ribbon {
				position: absolute;
				top: 0;
				left: 0;
				width: 56px;
				height: 56px;
				overflow: hidden;
				pointer-events: none;
			}
			.ribbon span {
				position: absolute;
				display: block;
				width: 90px;
				padding: 3px 0;
				text-align: center;
				font-size: 11px;
				font-weight: 900;
				transform: rotate(-45deg);
				top: 12px;
				left: -22px;
			}
		</style>
	</head>
	<body class="bg-[#0b0914] text-slate-100 min-h-screen p-4 md:p-8 font-sans selection:bg-purple-500 selection:text-white relative overflow-x-hidden">

		<!-- Cosmic Background Effect -->
		<div class="fixed inset-0 pointer-events-none -z-10 bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-purple-900/30 via-slate-950 to-[#08060f]"></div>
		<div class="fixed top-[-10%] left-1/2 -translate-x-1/2 w-[800px] h-[400px] bg-purple-600/15 blur-[120px] rounded-full pointer-events-none -z-10"></div>

		<!-- Navigation Bar -->
		<header class="max-w-7xl mx-auto flex flex-col md:flex-row justify-between items-center mb-6 gap-4 border-b border-purple-900/30 pb-4">
			<div class="flex items-center space-x-3">
				<h1 class="text-2xl font-black tracking-widest text-white">
					MOON <span class="text-purple-400">TIERS</span>
				</h1>
			</div>

			<nav class="flex items-center space-x-6 text-sm font-semibold text-slate-400">
				<a href="#" class="hover:text-slate-200 transition-colors">PLAYERS</a>
				<button id="info-btn" class="flex items-center justify-center w-8 h-8 rounded-full border border-purple-500/40 bg-purple-900/30 text-purple-300 hover:bg-purple-800/40 transition-colors font-bold">
					i
				</button>
				<a href="https://discord.gg/6d458aGxNy" target="_blank" class="bg-indigo-600 hover:bg-indigo-500 text-white px-4 py-2 rounded-lg transition-all shadow-md shadow-indigo-950/80">Discord</a>
			</nav>
		</header>

		<!-- Main Container -->
		<main class="max-w-7xl mx-auto space-y-6">

			<!-- Gamemode Tab Bar + Search -->
			<div class="bg-slate-900/70 backdrop-blur-xl rounded-2xl border border-purple-500/20 p-3 shadow-2xl shadow-purple-950/50 flex flex-col md:flex-row gap-3 items-center">
				<div class="flex flex-wrap justify-center gap-2 flex-1">
					<button data-mode="ALL" class="mode-tab-btn active-tab flex flex-col items-center px-4 py-2 rounded-xl border border-purple-500/40 bg-purple-900/30 text-purple-300 font-bold text-xs uppercase transition-all hover:bg-purple-800/40">
						<span class="icon-sm mb-1" set:html={trophySvg} />
						Overall
					</button>
					{gamemodes.map((mode) => (
						<button data-mode={mode} class="mode-tab-btn flex flex-col items-center px-4 py-2 rounded-xl border border-slate-800 bg-slate-950/50 text-slate-400 font-bold text-xs uppercase transition-all hover:bg-purple-900/20 hover:text-purple-300">
							<span class="icon-sm mb-1" set:html={gamemodeSvg[mode]} />
							{mode}
						</button>
					))}
				</div>
				<div class="w-full md:w-64">
					<input
						type="text"
						id="player-search"
						placeholder="Search players..."
						class="w-full bg-slate-950/70 border border-slate-800 rounded-lg px-3 py-2 text-sm text-slate-200 placeholder-slate-500 focus:outline-none focus:border-purple-500/50"
					/>
				</div>
			</div>

			<div class="text-center">
				<h2 id="ranking-title" class="text-xl md:text-2xl font-black tracking-wider text-slate-200 uppercase">
					GLOBAL RANKINGS
				</h2>
				<p id="ranking-subtitle" class="text-xs text-slate-400 mt-1">Overall Leaderboard Across All Modes</p>
			</div>

			<!-- GLOBAL CARD VIEW -->
			<div id="global-card-view" class="space-y-3">
				{players.map((player) => (
					<div class="player-card relative overflow-hidden bg-slate-900/70 backdrop-blur-xl rounded-2xl border border-purple-500/20 p-4 shadow-xl shadow-purple-950/30 flex flex-col md:flex-row items-center gap-4" data-name={player.name.toLowerCase()}>
						{player.rank <= 3 && (
							<div class="ribbon">
								<span class={rankRibbonStyle[player.rank]}>{player.rank}</span>
							</div>
						)}
						<div class="flex items-center gap-4 w-full md:w-64 flex-shrink-0 pl-6">
							<div class="w-10 h-10 rounded-full border-2 border-purple-500/50 flex items-center justify-center font-black text-purple-300 bg-slate-950">
								#{player.rank}
							</div>
							<img src={player.avatar} alt={player.name} class="w-10 h-10 rounded-lg border border-slate-700" />
							<div>
								<div class="font-bold text-slate-100">{player.name}</div>
								<div class={`text-xs ${player.titleColor}`}>{player.title} · {player.totalPoints} pts</div>
							</div>
						</div>
						<div class="flex-shrink-0">
							<span class="px-2 py-0.5 text-xs font-bold bg-slate-800 text-slate-300 rounded border border-slate-700">
								{player.region}
							</span>
						</div>
						<div class="flex flex-wrap gap-2 flex-1 justify-start md:justify-end">
							{gamemodes.map((mode) => {
								const key = mode.replace(/\s+/g, '');
								const gData = player.tiers[key];
								if (!gData) return null;
								return (
									<div class="flex flex-col items-center bg-blue-950/50 border border-blue-500/40 rounded-lg px-2 py-1 min-w-[44px]" title={mode}>
										<span class="icon-xs text-blue-300 mb-0.5" set:html={gamemodeSvg[mode]} />
										<span class="text-xs font-black text-blue-300">{gData.tier}</span>
									</div>
								);
							})}
						</div>
					</div>
				))}
			</div>

			<!-- PER-GAMEMODE TIER-LIST VIEW -->
			<div id="tierlist-view" class="hidden space-y-6">
				{gamemodes.map((mode) => {
					const key = mode.replace(/\s+/g, '');
					const groups = tierListsByMode[key];
					return (
						<div id={`tierlist-${key}`} class="tierlist-mode hidden bg-slate-900/70 backdrop-blur-xl rounded-2xl border border-purple-500/20 p-6 shadow-2xl shadow-purple-950/50">
							<div class="grid grid-cols-1 md:grid-cols-5 gap-4">
								{[1, 2, 3, 4, 5].map((tierNum) => (
									<div>
										<div class={`flex items-center justify-center gap-1.5 font-black text-sm uppercase tracking-wider rounded-lg border py-2 mb-3 ${tierHeaderStyle[tierNum].wrap} ${tierHeaderStyle[tierNum].text}`}>
											<span class="icon-md" set:html={trophySvg} />
											Tier {tierNum}
										</div>
										<div class="space-y-2">
											{groups[tierNum].length > 0 ? (
												groups[tierNum].map((p) => (
													<div class="tierlist-player flex items-center space-x-2 bg-slate-950/70 border border-slate-800/60 rounded-lg px-3 py-2" data-name={p.name.toLowerCase()}>
														<img src={p.avatar} alt={p.name} class="w-6 h-6 rounded border border-slate-700" />
														<span class="text-sm font-semibold text-slate-100">{p.name}</span>
														<span class="ml-auto text-[10px] font-black text-blue-300">{p.tier}</span>
													</div>
												))
											) : (
												<div class="text-center text-xs text-slate-600 py-4">No players</div>
											)}
										</div>
									</div>
								))}
							</div>
						</div>
					);
				})}
			</div>

			<!-- Footer Legend -->
			<div class="bg-slate-900/60 border border-slate-800/80 rounded-xl p-4 text-center text-xs text-slate-400 space-y-2 font-mono">
				<div class="flex flex-wrap justify-center gap-4">
					<span><b class="text-amber-400">HT1</b> = 60</span>
					<span><b class="text-amber-500">LT1</b> = 45</span>
					<span><b class="text-purple-400">HT2</b> = 30</span>
					<span><b class="text-purple-500">LT2</b> = 20</span>
					<span><b class="text-blue-400">HT3</b> = 10</span>
					<span><b class="text-blue-500">LT3</b> = 6</span>
					<span><b class="text-cyan-400">HT4</b> = 4</span>
					<span><b class="text-cyan-500">LT4</b> = 3</span>
					<span><b class="text-slate-400">HT5</b> = 2</span>
					<span><b class="text-slate-500">LT5</b> = 1</span>
				</div>
				<div class="text-[11px] text-slate-500 pt-1 border-t border-slate-800/60">
					Rookie &lt;10 | Combat Novice 10+ | Combat Cadet 20+ | Combat Specialist 50+ | Combat Ace 100+ | Combat Master 250+ | Combat Grandmaster 450+
				</div>
			</div>

		</main>

		<!-- Info Modal -->
		<div id="info-modal-overlay" class="hidden fixed inset-0 bg-black/70 backdrop-blur-sm z-50 flex items-center justify-center p-4">
			<div class="bg-slate-950 border border-purple-500/30 rounded-2xl max-w-lg w-full max-h-[85vh] overflow-y-auto shadow-2xl shadow-purple-950">
				<div class="sticky top-0 bg-slate-950 border-b border-slate-800 p-5 flex items-center justify-between">
					<div class="flex items-center gap-3">
						<div class="w-9 h-9 rounded-lg bg-purple-900/40 border border-purple-500/40 flex items-center justify-center text-purple-300 font-black">i</div>
						<h3 class="text-lg font-black text-white uppercase tracking-wide">Ranking System</h3>
					</div>
					<button id="info-close-btn" class="text-slate-400 hover:text-white text-xl font-bold px-2">&times;</button>
				</div>
				<div class="p-5 space-y-6">
					<p class="text-xs text-slate-400 leading-relaxed">
						Each rank you earn in any gamemode gives you points. Your total points across all gamemodes determine your overall position.
					</p>

					<div>
						<div class="text-purple-400 text-xs font-black uppercase tracking-wider border-l-2 border-purple-500 pl-2 mb-3">Points Per Rank</div>
						<div class="grid grid-cols-2 gap-2">
							{rankPoints.map((r) => (
								<div class="flex items-center justify-between bg-slate-900/70 border border-slate-800 rounded-lg px-3 py-2">
									<span class="text-xs font-black text-blue-300 bg-blue-950/60 border border-blue-500/40 px-2 py-0.5 rounded">{r.tier}</span>
									<span class="text-sm font-bold text-purple-300">{r.pts} PTS</span>
								</div>
							))}
						</div>
					</div>

					<div>
						<div class="text-purple-400 text-xs font-black uppercase tracking-wider border-l-2 border-purple-500 pl-2 mb-3">Titles List</div>
						<div class="space-y-2">
							{titlesList.map((t) => (
								<div class="flex items-center justify-between bg-slate-900/70 border border-slate-800 rounded-lg px-3 py-2.5">
									<div class="flex items-center gap-2">
										<span class="text-base">{t.icon}</span>
										<span class={`text-sm font-bold ${t.color}`}>{t.name}</span>
									</div>
									<span class="text-xs text-slate-400">{t.threshold > 0 ? `${t.threshold}+ PTS` : '<10 PTS'}</span>
								</div>
							))}
						</div>
					</div>
				</div>
			</div>
		</div>

		<!-- Script to handle Tab Switching, Filtering, Search, and Info Modal -->
		<script>
			const titleEl = document.getElementById('ranking-title');
			const subtitleEl = document.getElementById('ranking-subtitle');
			const globalCardView = document.getElementById('global-card-view');
			const tierlistView = document.getElementById('tierlist-view');
			const searchInput = document.getElementById('player-search');

			const modeTabBtns = document.querySelectorAll('.mode-tab-btn');
			const allTierlistModes = document.querySelectorAll('.tierlist-mode');

			function setActiveTab(btn) {
				modeTabBtns.forEach(b => {
					b.classList.remove('active-tab', 'border-purple-500/40', 'bg-purple-900/30', 'text-purple-300');
					b.classList.add('border-slate-800', 'bg-slate-950/50', 'text-slate-400');
				});
				btn.classList.add('active-tab', 'border-purple-500/40', 'bg-purple-900/30', 'text-purple-300');
				btn.classList.remove('border-slate-800', 'bg-slate-950/50', 'text-slate-400');
			}

			function selectGamemode(selectedMode, btn) {
				if (btn) setActiveTab(btn);

				if (selectedMode === 'ALL') {
					if (titleEl) titleEl.textContent = 'GLOBAL RANKINGS';
					if (subtitleEl) subtitleEl.textContent = 'Overall Leaderboard Across All Modes';
					globalCardView?.classList.remove('hidden');
					tierlistView?.classList.add('hidden');
					allTierlistModes.forEach(el => el.classList.add('hidden'));
				} else {
					if (titleEl) titleEl.textContent = `${selectedMode} RANKINGS`;
					if (subtitleEl) subtitleEl.textContent = `Displaying scores for ${selectedMode} only`;

					const targetKey = selectedMode.replace(/\s+/g, '');

					globalCardView?.classList.add('hidden');
					tierlistView?.classList.remove('hidden');
					allTierlistModes.forEach(el => {
						if (el.id === `tierlist-${targetKey}`) {
							el.classList.remove('hidden');
						} else {
							el.classList.add('hidden');
						}
					});
				}
				applySearch();
			}

			modeTabBtns.forEach(btn => {
				btn.addEventListener('click', () => {
					const mode = btn.getAttribute('data-mode');
					if (mode) selectGamemode(mode, btn);
				});
			});

			function applySearch() {
				const query = (searchInput?.value || '').trim().toLowerCase();

				document.querySelectorAll('.player-card').forEach(card => {
					const name = card.getAttribute('data-name') || '';
					card.style.display = name.includes(query) ? '' : 'none';
				});

				document.querySelectorAll('.tierlist-player').forEach(row => {
					const name = row.getAttribute('data-name') || '';
					row.style.display = name.includes(query) ? '' : 'none';
				});
			}

			searchInput?.addEventListener('input', applySearch);

			// Info Modal
			const infoBtn = document.getElementById('info-btn');
			const infoCloseBtn = document.getElementById('info-close-btn');
			const infoModalOverlay = document.getElementById('info-modal-overlay');

			infoBtn?.addEventListener('click', () => {
				infoModalOverlay?.classList.remove('hidden');
			});
			infoCloseBtn?.addEventListener('click', () => {
				infoModalOverlay?.classList.add('hidden');
			});
			infoModalOverlay?.addEventListener('click', (e) => {
				if (e.target === infoModalOverlay) {
					infoModalOverlay.classList.add('hidden');
				}
			});
		</script>
	</body>
</html>